# Export variables in your terminal/IDE; Spring Boot does not automatically load this file.
# Backend defaults to SQL Server. For a local H2 database, use scripts/run-local.sh.
# SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=InternalWebsiteUptimeChecker;encrypt=true;trustServerCertificate=true;
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=
# Optional persistent H2 path (used by the h2 profile)
# LOCAL_DB_URL=jdbc:h2:file:./data/qlwebsite-local;MODE=MSSQLServer;AUTO_SERVER=TRUE

# Frontend connection
BACKEND_URL=http://127.0.0.1:8082
# Set false to suspend automatic checks.
MONITOR_JOBS_ENABLED=true
